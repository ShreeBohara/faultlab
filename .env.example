WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=Faultlab
WANDB_MODEL=deepseek-ai/DeepSeek-V3.1
WANDB_EXPLORER_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
WANDB_MECHANIC_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=

# Offline by default. Configure only for an explicitly requested bounded live action.
FAULTLAB_ARTIFACT_DIR=artifacts
# Set true to inspect existing evidence without recovery, execution or changes.
FAULTLAB_READ_ONLY=false
FAULTLAB_SIMULATOR_URL=http://127.0.0.1:8001
FAULTLAB_CONTROL_TOKEN=
FAULTLAB_LIVE_ENABLED=false
FAULTLAB_ACTOR_CONTEXT_PROTOCOL=faultlab-actor-context/v4-indexed-evidence
# Aria remains deferred; Inference and Weave do not require it.
FAULTLAB_ARIA_PUBLISH_ENABLED=false
FAULTLAB_CONFIRMED_ENTITY=
FAULTLAB_MODEL_CALL_CAP=6000
FAULTLAB_TOKEN_CAP=204000000
FAULTLAB_DOLLAR_CAP=100
FAULTLAB_INPUT_DOLLARS_PER_MILLION=-1
FAULTLAB_OUTPUT_DOLLARS_PER_MILLION=-1
FAULTLAB_PRICING_MODEL=
FAULTLAB_PRICING_VERIFIED=false
FAULTLAB_REASONING_INPUT_DOLLARS_PER_MILLION=-1
FAULTLAB_REASONING_OUTPUT_DOLLARS_PER_MILLION=-1
FAULTLAB_REASONING_PRICING_MODEL=
FAULTLAB_REASONING_PRICING_VERIFIED=false
FAULTLAB_LAB_MODEL=
FAULTLAB_LAB_PRICING_MODEL=
FAULTLAB_LAB_INPUT_DOLLARS_PER_MILLION=-1
FAULTLAB_LAB_OUTPUT_DOLLARS_PER_MILLION=-1

# ---- Model providers (docs/providers.md) ----
# A model is "provider:model_id" (wandb, openai, anthropic, openrouter, custom). An unprefixed name
# belongs to FAULTLAB_DEFAULT_PROVIDER. Explicit role models win over the WANDB_* selections above.
FAULTLAB_DEFAULT_PROVIDER=wandb
FAULTLAB_ACTOR_MODEL=
FAULTLAB_EXPLORER_MODEL=
FAULTLAB_MECHANIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for an Anthropic key that is not scoped to a workspace (the API then demands the workspace id).
ANTHROPIC_WORKSPACE_ID=
OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint (a local server, a proxy). Both are required to use "custom:".
FAULTLAB_CUSTOM_BASE_URL=
FAULTLAB_CUSTOM_API_KEY=
# Every priced call reserves its worst-case dollars in <artifact dir>/spend-ledger.sqlite3 before it is
# sent. The calendar month's reserved total never exceeds this cap, across campaigns and smoke checks.
FAULTLAB_MONTHLY_DOLLAR_CAP=100
# The ledger file itself; blank means ~/.faultlab/spend-ledger.sqlite3 (one per machine, shared by every store).
FAULTLAB_SPEND_LEDGER=
# Verified, dated prices: backend/app/providers/pricing.json unless a path is given here. An entry
# older than 90 days stops pricing calls unless FAULTLAB_ALLOW_STALE_PRICES=true.
FAULTLAB_PRICING_TABLE=
FAULTLAB_ALLOW_STALE_PRICES=false
# Weave tracing of campaign calls needs the W&B credentials above. Campaign execution still starts
# the Weave worker whatever this says (see docs/providers.md); false only lifts the entity rule.
FAULTLAB_WEAVE_ENABLED=true
