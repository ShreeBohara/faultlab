{
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Operation Id",
      "type": "string"
    },
    "service": {
      "enum": [
        "orders",
        "notifications"
      ],
      "title": "Service",
      "type": "string"
    },
    "order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Order Id",
      "type": "string"
    },
    "intent_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "terminal_tick": {
      "maximum": 25,
      "minimum": 0,
      "title": "Terminal Tick",
      "type": "integer"
    },
    "committed_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed Version"
    },
    "effect_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effect Id"
    },
    "failure_code": {
      "anyOf": [
        {
          "enum": [
            "UPGRADE_REJECTED",
            "VERSION_CONFLICT"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    }
  },
  "required": [
    "receipt_id",
    "operation_id",
    "service",
    "order_id",
    "intent_hash",
    "status",
    "terminal_tick"
  ],
  "title": "Receipt",
  "type": "object"
}
