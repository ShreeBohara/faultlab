{
  "$defs": {
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "http_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Http Attempts",
          "type": "integer"
        },
        "actor_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Actor Calls",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wait_cycles": {
          "default": 0,
          "minimum": 0,
          "title": "Wait Cycles",
          "type": "integer"
        },
        "ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Ticks",
          "type": "integer"
        },
        "policy_steps": {
          "default": 0,
          "minimum": 0,
          "title": "Policy Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "cost_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Dollars"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Episode Id",
      "type": "string"
    },
    "world_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "World Id",
      "type": "string"
    },
    "scenario_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scenario Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "arm": {
      "enum": [
        "B0",
        "B1",
        "L"
      ],
      "title": "Arm",
      "type": "string"
    },
    "trial_index": {
      "maximum": 2,
      "minimum": 0,
      "title": "Trial Index",
      "type": "integer"
    },
    "lifecycle": {
      "enum": [
        "COMPLETED",
        "INTERRUPTED",
        "LAB_ERROR"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "COMPLETED",
            "SAFE_UNRESOLVED",
            "CORRECTLY_REJECTED",
            "VIOLATION",
            "LAB_ERROR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outcome"
    },
    "failed_checks": {
      "items": {
        "enum": [
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "C7",
          "C8"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "title": "Failed Checks",
      "type": "array"
    },
    "fault_scheduled": {
      "title": "Fault Scheduled",
      "type": "boolean"
    },
    "fault_triggered": {
      "title": "Fault Triggered",
      "type": "boolean"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "episode_id",
    "world_id",
    "scenario_hash",
    "policy_hash",
    "arm",
    "trial_index",
    "lifecycle",
    "outcome",
    "fault_scheduled",
    "fault_triggered"
  ],
  "title": "TrialResult",
  "type": "object"
}
