{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "notification_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Notification Id",
      "type": "string"
    },
    "order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Order Id",
      "type": "string"
    },
    "upgrade_operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Upgrade Operation Id",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Operation Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "created_tick": {
      "maximum": 25,
      "minimum": 0,
      "title": "Created Tick",
      "type": "integer"
    },
    "template_version": {
      "const": "confirmation/v1",
      "default": "confirmation/v1",
      "title": "Template Version",
      "type": "string"
    }
  },
  "required": [
    "notification_id",
    "order_id",
    "upgrade_operation_id",
    "operation_id",
    "idempotency_key",
    "payload_hash",
    "created_tick"
  ],
  "title": "NotificationEffect",
  "type": "object"
}
