{
  "$defs": {
    "CheckNextAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CHECK_EXISTING_UPGRADE",
            "CHECK_EXISTING_NOTIFICATION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "operation_id"
      ],
      "title": "CheckNextAction",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "category": {
          "maxLength": 80,
          "title": "Category",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 36,
          "title": "Evidence Ids",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "passed",
        "category"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "FaultExecution": {
      "additionalProperties": false,
      "properties": {
        "fault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Fault Id",
          "type": "string"
        },
        "scheduled": {
          "default": true,
          "title": "Scheduled",
          "type": "boolean"
        },
        "triggered": {
          "default": false,
          "title": "Triggered",
          "type": "boolean"
        },
        "trigger_tick": {
          "anyOf": [
            {
              "maximum": 25,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Tick"
        },
        "call_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "attempt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "fault_id"
      ],
      "title": "FaultExecution",
      "type": "object"
    },
    "NoNextAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "ESCALATE"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoNextAction",
      "type": "object"
    },
    "TaskReport": {
      "additionalProperties": false,
      "properties": {
        "upgrade_outcome": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN"
          ],
          "title": "Upgrade Outcome",
          "type": "string"
        },
        "notification_outcome": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN",
            "NOT_REQUIRED"
          ],
          "title": "Notification Outcome",
          "type": "string"
        },
        "overall": {
          "enum": [
            "COMPLETED",
            "SAFE_UNRESOLVED",
            "CORRECTLY_REJECTED"
          ],
          "title": "Overall",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 18,
          "title": "Evidence Ids",
          "type": "array"
        },
        "next_action": {
          "discriminator": {
            "mapping": {
              "CHECK_EXISTING_NOTIFICATION": "#/$defs/CheckNextAction",
              "CHECK_EXISTING_UPGRADE": "#/$defs/CheckNextAction",
              "ESCALATE": "#/$defs/NoNextAction",
              "NONE": "#/$defs/NoNextAction"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoNextAction"
            },
            {
              "$ref": "#/$defs/CheckNextAction"
            }
          ],
          "title": "Next Action"
        }
      },
      "required": [
        "upgrade_outcome",
        "notification_outcome",
        "overall",
        "evidence_ids",
        "next_action"
      ],
      "title": "TaskReport",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "http_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Http Attempts",
          "type": "integer"
        },
        "actor_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Actor Calls",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wait_cycles": {
          "default": 0,
          "minimum": 0,
          "title": "Wait Cycles",
          "type": "integer"
        },
        "ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Ticks",
          "type": "integer"
        },
        "policy_steps": {
          "default": 0,
          "minimum": 0,
          "title": "Policy Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "cost_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Dollars"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "faultlab/v1",
          "default": "faultlab/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Verdict Id",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Episode Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "COMPLETED",
            "SAFE_UNRESOLVED",
            "CORRECTLY_REJECTED",
            "VIOLATION",
            "LAB_ERROR"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Checks",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 18,
          "title": "Evidence Ids",
          "type": "array"
        },
        "supported_completion": {
          "title": "Supported Completion",
          "type": "boolean"
        },
        "useful_resolution": {
          "enum": [
            "completed",
            "rejected",
            "unresolved",
            "invalid"
          ],
          "title": "Useful Resolution",
          "type": "string"
        },
        "fault_executions": {
          "items": {
            "$ref": "#/$defs/FaultExecution"
          },
          "maxItems": 2,
          "title": "Fault Executions",
          "type": "array"
        },
        "upgrade_effects": {
          "minimum": 0,
          "title": "Upgrade Effects",
          "type": "integer"
        },
        "notification_effects": {
          "minimum": 0,
          "title": "Notification Effects",
          "type": "integer"
        },
        "decision_tick": {
          "maximum": 20,
          "minimum": 0,
          "title": "Decision Tick",
          "type": "integer"
        },
        "horizon_tick": {
          "maximum": 25,
          "minimum": 0,
          "title": "Horizon Tick",
          "type": "integer"
        },
        "scorer_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scorer Hash",
          "type": "string"
        }
      },
      "required": [
        "verdict_id",
        "episode_id",
        "outcome",
        "checks",
        "supported_completion",
        "useful_resolution",
        "upgrade_effects",
        "notification_effects",
        "decision_tick",
        "horizon_tick",
        "scorer_hash"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "campaign_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Campaign Id",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Episode Id",
      "type": "string"
    },
    "origin": {
      "enum": [
        "prototype",
        "faultlab_evaluation"
      ],
      "title": "Origin",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "promotion",
        "final_audit"
      ],
      "title": "Split",
      "type": "string"
    },
    "arm": {
      "enum": [
        "B0",
        "B1",
        "L"
      ],
      "title": "Arm",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "live",
        "replay",
        "offline_fixture"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "experiment_purpose": {
      "enum": [
        "discovery",
        "reproduction",
        "reduction",
        "intervention",
        "source_validation",
        "challenge",
        "promotion",
        "final_audit",
        "portability",
        "selection_comparison",
        "diagnostic_profile"
      ],
      "title": "Experiment Purpose",
      "type": "string"
    },
    "trial_index": {
      "maximum": 2,
      "minimum": 0,
      "title": "Trial Index",
      "type": "integer"
    },
    "study_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Study Id",
      "type": "string"
    },
    "evidence_context_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Evidence Context Id",
      "type": "string"
    },
    "selector_id": {
      "anyOf": [
        {
          "enum": [
            "explorer",
            "systematic",
            "random"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selector Id"
    },
    "execution_epoch": {
      "minimum": 0,
      "title": "Execution Epoch",
      "type": "integer"
    },
    "agent_registration_id": {
      "default": "orders-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Agent Registration Id",
      "type": "string"
    },
    "parent_experiment_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Experiment Id"
    },
    "world_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "World Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "scenario_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scenario Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Policy Version",
      "type": "string"
    },
    "model": {
      "maxLength": 600,
      "title": "Model",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "lifecycle": {
      "default": "CREATED",
      "enum": [
        "CREATED",
        "RUNNING",
        "SCORING",
        "COMPLETED",
        "INTERRUPTED",
        "LAB_ERROR"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "campaign_id",
    "episode_id",
    "origin",
    "split",
    "arm",
    "source_mode",
    "experiment_purpose",
    "trial_index",
    "study_id",
    "evidence_context_id",
    "execution_epoch",
    "world_id",
    "task_id",
    "scenario_hash",
    "policy_hash",
    "policy_version",
    "model",
    "configuration_hash"
  ],
  "title": "Episode",
  "type": "object"
}
