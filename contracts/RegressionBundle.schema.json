{
  "$defs": {
    "EpisodeBudget": {
      "additionalProperties": false,
      "properties": {
        "http_attempts": {
          "default": 18,
          "maximum": 18,
          "minimum": 1,
          "title": "Http Attempts",
          "type": "integer"
        },
        "actor_calls": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Actor Calls",
          "type": "integer"
        },
        "wait_cycles": {
          "default": 4,
          "maximum": 4,
          "minimum": 0,
          "title": "Wait Cycles",
          "type": "integer"
        },
        "ticks": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Ticks",
          "type": "integer"
        },
        "policy_steps": {
          "default": 32,
          "maximum": 32,
          "minimum": 0,
          "title": "Policy Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 90,
          "maximum": 90,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "title": "EpisodeBudget",
      "type": "object"
    },
    "F1": {
      "additionalProperties": false,
      "properties": {
        "target_tool": {
          "enum": [
            "update_order",
            "send_confirmation"
          ],
          "title": "Target Tool",
          "type": "string"
        },
        "target_service": {
          "enum": [
            "orders",
            "notifications"
          ],
          "title": "Target Service",
          "type": "string"
        },
        "occurrence": {
          "maximum": 18,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "kind": {
          "const": "F1",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/F1Parameters"
        }
      },
      "required": [
        "target_tool",
        "target_service",
        "occurrence",
        "kind",
        "parameters"
      ],
      "title": "F1",
      "type": "object"
    },
    "F1Parameters": {
      "additionalProperties": false,
      "properties": {
        "response_delay_ms": {
          "maximum": 3000,
          "minimum": 1500,
          "title": "Response Delay Ms",
          "type": "integer"
        }
      },
      "required": [
        "response_delay_ms"
      ],
      "title": "F1Parameters",
      "type": "object"
    },
    "F2": {
      "additionalProperties": false,
      "properties": {
        "target_tool": {
          "const": "update_order",
          "title": "Target Tool",
          "type": "string"
        },
        "target_service": {
          "const": "orders",
          "title": "Target Service",
          "type": "string"
        },
        "occurrence": {
          "maximum": 18,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "kind": {
          "const": "F2",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/F2Parameters"
        }
      },
      "required": [
        "target_tool",
        "target_service",
        "occurrence",
        "kind",
        "parameters"
      ],
      "title": "F2",
      "type": "object"
    },
    "F2Parameters": {
      "additionalProperties": false,
      "properties": {
        "completion_delay_ticks": {
          "maximum": 20,
          "minimum": 1,
          "title": "Completion Delay Ticks",
          "type": "integer"
        },
        "terminal_status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Terminal Status",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "const": "UPGRADE_REJECTED",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        }
      },
      "required": [
        "completion_delay_ticks",
        "terminal_status",
        "failure_code"
      ],
      "title": "F2Parameters",
      "type": "object"
    },
    "F3": {
      "additionalProperties": false,
      "properties": {
        "target_tool": {
          "const": "get_order",
          "title": "Target Tool",
          "type": "string"
        },
        "target_service": {
          "const": "orders",
          "title": "Target Service",
          "type": "string"
        },
        "occurrence": {
          "maximum": 18,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "kind": {
          "const": "F3",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/F3Parameters"
        }
      },
      "required": [
        "target_tool",
        "target_service",
        "occurrence",
        "kind",
        "parameters"
      ],
      "title": "F3",
      "type": "object"
    },
    "F3Parameters": {
      "additionalProperties": false,
      "properties": {
        "versions_back": {
          "maximum": 3,
          "minimum": 1,
          "title": "Versions Back",
          "type": "integer"
        }
      },
      "required": [
        "versions_back"
      ],
      "title": "F3Parameters",
      "type": "object"
    },
    "F4": {
      "additionalProperties": false,
      "properties": {
        "target_tool": {
          "enum": [
            "get_order",
            "update_order",
            "get_operation_status",
            "send_confirmation"
          ],
          "title": "Target Tool",
          "type": "string"
        },
        "target_service": {
          "enum": [
            "orders",
            "notifications"
          ],
          "title": "Target Service",
          "type": "string"
        },
        "occurrence": {
          "maximum": 18,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "kind": {
          "const": "F4",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/F4Parameters"
        }
      },
      "required": [
        "target_tool",
        "target_service",
        "occurrence",
        "kind",
        "parameters"
      ],
      "title": "F4",
      "type": "object"
    },
    "F4Parameters": {
      "additionalProperties": false,
      "properties": {
        "failure_count": {
          "maximum": 18,
          "minimum": 1,
          "title": "Failure Count",
          "type": "integer"
        }
      },
      "required": [
        "failure_count"
      ],
      "title": "F4Parameters",
      "type": "object"
    },
    "FaultSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "faultlab/v1",
          "default": "faultlab/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "orders.upgrade_then_confirm/v1",
          "default": "orders.upgrade_then_confirm/v1",
          "title": "Scope",
          "type": "string"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "primitives": {
          "items": {
            "discriminator": {
              "mapping": {
                "F1": "#/$defs/F1",
                "F2": "#/$defs/F2",
                "F3": "#/$defs/F3",
                "F4": "#/$defs/F4"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/F1"
              },
              {
                "$ref": "#/$defs/F2"
              },
              {
                "$ref": "#/$defs/F3"
              },
              {
                "$ref": "#/$defs/F4"
              }
            ]
          },
          "maxItems": 2,
          "title": "Primitives",
          "type": "array"
        }
      },
      "required": [
        "seed",
        "primitives"
      ],
      "title": "FaultSpec",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "TrialResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "faultlab/v1",
          "default": "faultlab/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Episode Id",
          "type": "string"
        },
        "world_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "World Id",
          "type": "string"
        },
        "scenario_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scenario Hash",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "arm": {
          "enum": [
            "B0",
            "B1",
            "L"
          ],
          "title": "Arm",
          "type": "string"
        },
        "trial_index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Trial Index",
          "type": "integer"
        },
        "lifecycle": {
          "enum": [
            "COMPLETED",
            "INTERRUPTED",
            "LAB_ERROR"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "COMPLETED",
                "SAFE_UNRESOLVED",
                "CORRECTLY_REJECTED",
                "VIOLATION",
                "LAB_ERROR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "failed_checks": {
          "items": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Failed Checks",
          "type": "array"
        },
        "fault_scheduled": {
          "title": "Fault Scheduled",
          "type": "boolean"
        },
        "fault_triggered": {
          "title": "Fault Triggered",
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "episode_id",
        "world_id",
        "scenario_hash",
        "policy_hash",
        "arm",
        "trial_index",
        "lifecycle",
        "outcome",
        "fault_scheduled",
        "fault_triggered"
      ],
      "title": "TrialResult",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "http_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Http Attempts",
          "type": "integer"
        },
        "actor_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Actor Calls",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wait_cycles": {
          "default": 0,
          "minimum": 0,
          "title": "Wait Cycles",
          "type": "integer"
        },
        "ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Ticks",
          "type": "integer"
        },
        "policy_steps": {
          "default": 0,
          "minimum": 0,
          "title": "Policy Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "cost_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Dollars"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "export_version": {
      "const": "faultlab-regression/v1",
      "default": "faultlab-regression/v1",
      "title": "Export Version",
      "type": "string"
    },
    "bundle_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Bundle Id",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "harness_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Harness Version",
      "type": "string"
    },
    "harness_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Harness Hash",
      "type": "string"
    },
    "source_recipe": {
      "$ref": "#/$defs/FaultSpec"
    },
    "retained_recipe": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaultSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_id": {
      "enum": [
        "standard-v1",
        "history-v1"
      ],
      "title": "Fixture Id",
      "type": "string"
    },
    "scope": {
      "const": "orders.upgrade_then_confirm/v1",
      "default": "orders.upgrade_then_confirm/v1",
      "title": "Scope",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "capability_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capability Hash",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "scorer_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scorer Hash",
      "type": "string"
    },
    "interpreter_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Interpreter Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "schema_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Hash",
      "type": "string"
    },
    "dependency_lock_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dependency Lock Hash",
      "type": "string"
    },
    "target_invariant": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8"
      ],
      "title": "Target Invariant",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Source Refs",
      "type": "array"
    },
    "trial_results": {
      "items": {
        "$ref": "#/$defs/TrialResult"
      },
      "maxItems": 200,
      "title": "Trial Results",
      "type": "array"
    },
    "registration_requirements": {
      "items": {
        "maxLength": 600,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Registration Requirements",
      "type": "array"
    },
    "execution_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Execution Profile Id",
      "type": "string"
    },
    "caps": {
      "$ref": "#/$defs/EpisodeBudget"
    },
    "setup_instructions": {
      "maxLength": 600,
      "title": "Setup Instructions",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "manifest_hash",
    "files",
    "harness_version",
    "harness_hash",
    "source_recipe",
    "retained_recipe",
    "fixture_id",
    "contract_hash",
    "capability_hash",
    "configuration_hash",
    "scorer_hash",
    "interpreter_hash",
    "policy_hash",
    "schema_hash",
    "dependency_lock_hash",
    "target_invariant",
    "source_refs",
    "trial_results",
    "registration_requirements",
    "execution_profile_id",
    "caps",
    "setup_instructions"
  ],
  "title": "RegressionBundle",
  "type": "object"
}
