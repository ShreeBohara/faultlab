{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "regression_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Regression Id",
      "type": "string"
    },
    "campaign_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Campaign Id",
      "type": "string"
    },
    "counterexample_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Counterexample Id",
      "type": "string"
    },
    "target_invariant": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8"
      ],
      "title": "Target Invariant",
      "type": "string"
    },
    "scope": {
      "const": "orders.upgrade_then_confirm/v1",
      "default": "orders.upgrade_then_confirm/v1",
      "title": "Scope",
      "type": "string"
    },
    "first_failing_policy": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "First Failing Policy",
      "type": "string"
    },
    "accepted_policy": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Accepted Policy"
    },
    "reduction_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reduction Ref"
    },
    "diagnostic_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Diagnostic Ref"
    },
    "challenge_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Challenge Ref"
    },
    "bundle_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bundle Id"
    }
  },
  "required": [
    "regression_id",
    "campaign_id",
    "counterexample_id",
    "target_invariant",
    "first_failing_policy",
    "accepted_policy",
    "reduction_ref",
    "diagnostic_ref",
    "challenge_ref",
    "bundle_id"
  ],
  "title": "RegressionCase",
  "type": "object"
}
