{
  "$defs": {
    "CheckNextAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CHECK_EXISTING_UPGRADE",
            "CHECK_EXISTING_NOTIFICATION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "operation_id"
      ],
      "title": "CheckNextAction",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "category": {
          "maxLength": 80,
          "title": "Category",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 36,
          "title": "Evidence Ids",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "passed",
        "category"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "NoNextAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "ESCALATE"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoNextAction",
      "type": "object"
    },
    "OperationData": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "service": {
          "enum": [
            "orders",
            "notifications"
          ],
          "title": "Service",
          "type": "string"
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "intent_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "service",
        "order_id",
        "intent_hash",
        "status"
      ],
      "title": "OperationData",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "applied_shipping": {
          "enum": [
            "standard",
            "express"
          ],
          "title": "Applied Shipping",
          "type": "string"
        },
        "requested_shipping": {
          "enum": [
            "standard",
            "express"
          ],
          "title": "Requested Shipping",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "last_upgrade_operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Upgrade Operation Id"
        }
      },
      "required": [
        "order_id",
        "applied_shipping",
        "requested_shipping",
        "version"
      ],
      "title": "Order",
      "type": "object"
    },
    "PublicObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "faultlab/v1",
          "default": "faultlab/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Episode Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Call Id",
          "type": "string"
        },
        "delivered_tick": {
          "maximum": 20,
          "minimum": 0,
          "title": "Delivered Tick",
          "type": "integer"
        },
        "result": {
          "$ref": "#/$defs/ToolResult"
        },
        "observed_operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Operation Id"
        },
        "observed_order_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Order Id"
        },
        "observed_intent_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Intent Hash"
        },
        "source_receipt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Receipt Id"
        }
      },
      "required": [
        "evidence_id",
        "episode_id",
        "call_id",
        "delivered_tick",
        "result"
      ],
      "title": "PublicObservation",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Receipt Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "service": {
          "enum": [
            "orders",
            "notifications"
          ],
          "title": "Service",
          "type": "string"
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "intent_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intent Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "terminal_tick": {
          "maximum": 25,
          "minimum": 0,
          "title": "Terminal Tick",
          "type": "integer"
        },
        "committed_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed Version"
        },
        "effect_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "UPGRADE_REJECTED",
                "VERSION_CONFLICT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        }
      },
      "required": [
        "receipt_id",
        "operation_id",
        "service",
        "order_id",
        "intent_hash",
        "status",
        "terminal_tick"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "TaskReport": {
      "additionalProperties": false,
      "properties": {
        "upgrade_outcome": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN"
          ],
          "title": "Upgrade Outcome",
          "type": "string"
        },
        "notification_outcome": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN",
            "NOT_REQUIRED"
          ],
          "title": "Notification Outcome",
          "type": "string"
        },
        "overall": {
          "enum": [
            "COMPLETED",
            "SAFE_UNRESOLVED",
            "CORRECTLY_REJECTED"
          ],
          "title": "Overall",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 18,
          "title": "Evidence Ids",
          "type": "array"
        },
        "next_action": {
          "discriminator": {
            "mapping": {
              "CHECK_EXISTING_NOTIFICATION": "#/$defs/CheckNextAction",
              "CHECK_EXISTING_UPGRADE": "#/$defs/CheckNextAction",
              "ESCALATE": "#/$defs/NoNextAction",
              "NONE": "#/$defs/NoNextAction"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoNextAction"
            },
            {
              "$ref": "#/$defs/CheckNextAction"
            }
          ],
          "title": "Next Action"
        }
      },
      "required": [
        "upgrade_outcome",
        "notification_outcome",
        "overall",
        "evidence_ids",
        "next_action"
      ],
      "title": "TaskReport",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Call Id",
          "type": "string"
        },
        "tool": {
          "enum": [
            "get_order",
            "update_order",
            "get_operation_status",
            "send_confirmation"
          ],
          "title": "Tool",
          "type": "string"
        },
        "transport": {
          "enum": [
            "ok",
            "timeout",
            "error"
          ],
          "title": "Transport",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "order_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "PENDING",
                "SUCCEEDED",
                "FAILED",
                "UNKNOWN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "observed_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Version"
        },
        "receipt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "retry_after_ticks": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Ticks"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/Order"
            },
            {
              "$ref": "#/$defs/OperationData"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        }
      },
      "required": [
        "call_id",
        "tool",
        "transport"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Episode Id",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "scorer_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scorer Hash",
      "type": "string"
    },
    "source": {
      "enum": [
        "weave_verified",
        "local_only"
      ],
      "title": "Source",
      "type": "string"
    },
    "root_call_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Root Call Id"
    },
    "child_call_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Child Call Ids",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/PublicObservation"
      },
      "maxItems": 18,
      "title": "Observations",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "maxItems": 8,
      "title": "Findings",
      "type": "array"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieved At"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "source_project": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Project"
    }
  },
  "required": [
    "episode_id",
    "policy_hash",
    "contract_hash",
    "scorer_hash",
    "source",
    "root_call_id",
    "child_call_ids",
    "observations",
    "report",
    "findings",
    "retrieved_at",
    "digest",
    "source_project"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
