{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "category": {
          "maxLength": 80,
          "title": "Category",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 36,
          "title": "Evidence Ids",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "passed",
        "category"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "FaultExecution": {
      "additionalProperties": false,
      "properties": {
        "fault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Fault Id",
          "type": "string"
        },
        "scheduled": {
          "default": true,
          "title": "Scheduled",
          "type": "boolean"
        },
        "triggered": {
          "default": false,
          "title": "Triggered",
          "type": "boolean"
        },
        "trigger_tick": {
          "anyOf": [
            {
              "maximum": 25,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Tick"
        },
        "call_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "attempt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "fault_id"
      ],
      "title": "FaultExecution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "faultlab/v1",
      "default": "faultlab/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Verdict Id",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Episode Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "COMPLETED",
        "SAFE_UNRESOLVED",
        "CORRECTLY_REJECTED",
        "VIOLATION",
        "LAB_ERROR"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Checks",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 18,
      "title": "Evidence Ids",
      "type": "array"
    },
    "supported_completion": {
      "title": "Supported Completion",
      "type": "boolean"
    },
    "useful_resolution": {
      "enum": [
        "completed",
        "rejected",
        "unresolved",
        "invalid"
      ],
      "title": "Useful Resolution",
      "type": "string"
    },
    "fault_executions": {
      "items": {
        "$ref": "#/$defs/FaultExecution"
      },
      "maxItems": 2,
      "title": "Fault Executions",
      "type": "array"
    },
    "upgrade_effects": {
      "minimum": 0,
      "title": "Upgrade Effects",
      "type": "integer"
    },
    "notification_effects": {
      "minimum": 0,
      "title": "Notification Effects",
      "type": "integer"
    },
    "decision_tick": {
      "maximum": 20,
      "minimum": 0,
      "title": "Decision Tick",
      "type": "integer"
    },
    "horizon_tick": {
      "maximum": 25,
      "minimum": 0,
      "title": "Horizon Tick",
      "type": "integer"
    },
    "scorer_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scorer Hash",
      "type": "string"
    }
  },
  "required": [
    "verdict_id",
    "episode_id",
    "outcome",
    "checks",
    "supported_completion",
    "useful_resolution",
    "upgrade_effects",
    "notification_effects",
    "decision_tick",
    "horizon_tick",
    "scorer_hash"
  ],
  "title": "Verdict",
  "type": "object"
}
