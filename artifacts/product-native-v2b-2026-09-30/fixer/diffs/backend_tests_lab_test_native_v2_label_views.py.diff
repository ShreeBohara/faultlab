+def test_an_undecoded_token_reaches_the_evidence_summary_as_written():
+    """Review finding LOW-1 (September 30): model readers never see a label the adapter decoded, but a token it did
+    not decode (a guess such as obs-4) is part of the saved report and reaches their evidence summary unchanged, next
+    to the oN aliases of the rows the report did cite. summarize_evidence itself is unchanged (gate_freeze)."""
+    ids = [f'evidence-{n:032x}' for n in range(1, 5)]
+    def row(index):
+        return SimpleNamespace(evidence_id=ids[index], delivered_tick=index,
+                               result=SimpleNamespace(model_dump=lambda mode, index=index: {'tool': 'get_order', 'row': index}))
+    report = SimpleNamespace(model_dump=lambda mode: {'overall': 'COMPLETED', 'evidence_ids': [ids[0], ids[1], ids[3], 'obs-4']})
+    bundle = SimpleNamespace(episode_id='episode-guess', source='weave_verified', observations=[row(i) for i in range(4)],
+                             report=report, findings=[])
+    view = summarize_evidence([bundle])
+    episode, = view['episodes']
+    assert view['reports'][episode['report_row']]['evidence_ids'] == ['o1', 'o2', 'o4', 'obs-4']
