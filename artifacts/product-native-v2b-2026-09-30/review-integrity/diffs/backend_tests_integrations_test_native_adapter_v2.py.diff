+def test_an_observation_first_shown_later_gets_the_next_label_and_shown_ones_keep_theirs(tmp_path, monkeypatch):
+    """After the business budget closes, v1's tool result lists every journal row, the hidden first send attempt
+    included. It is shown for the first time then, so it gets the next number; the others keep theirs."""
+    with_broker_retried_send(monkeypatch)
+    def script(call, messages):
+        if call == 1: return {"name": "get_order", "arguments": {}}
+        if call == 2: return {"name": "update_order", "arguments": {"desired_shipping": "express"}}
+        if call == 3: return {"name": "send_confirmation", "arguments": {}}
+        if call == 4: return {"name": "get_order", "arguments": {}}             # over the 4-attempt budget: closes business
+        return unresolved_report(shown_evidence_ids(messages))
+    provider, outcome, context, store = episode(tmp_path, SmolagentsActorV2, script, caps=EpisodeBudget(http_attempts=4),
+                                                monkeypatch=monkeypatch)
+    ids = real_ids(context)
+    closed = provider.requests[4]
+    result = [row for row in embedded_objects(closed["messages"]) if "error" in row and "observations" in row][0]
+    assert result["error"].startswith("Business budget exhausted")
+    # Journal order in the list; labels by first showing: rows 1, 2 and 4 keep obs-1..obs-3, row 3 is new: obs-4.
+    assert [row["evidence_id"] for row in result["observations"]] == ["obs-1", "obs-2", "obs-4", "obs-3"]
+    assert not REAL_ID.search(request_text(closed))
+    assert outcome["report"]["evidence_ids"] == [ids[0], ids[1], ids[3], ids[2]]
+    payload = events(store, context, "report_submitted")[0]["payload"]
+    assert payload["labels_shown_to_agent"] == ["obs-1", "obs-2", "obs-3", "obs-4"]
+    assert payload["evidence_labels"] == {ids[0]: "obs-1", ids[1]: "obs-2", ids[3]: "obs-3", ids[2]: "obs-4"}
+    assert scored_references(context, outcome["report"]) == "PASSES"
+
