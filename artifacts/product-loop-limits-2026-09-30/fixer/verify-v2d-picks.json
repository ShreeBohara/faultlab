  {
   "hook": "after_upgrade_response",
   "steps": [
    {
     "only_if": "always",
     "op": "wait_ticks",
     "ticks": 1
    },
    {
     "only_if": "always",
     "op": "read_current_operation"
    },
    {
     "only_if": "always",
     "op": "require_receipt",
     "service": "orders",
     "status": "SUCCEEDED"
    }
   ],
   "when": "upgrade_outcome_uncertain"
  },
  {
   "hook": "after_upgrade_response",
   "steps": [
    {
     "only_if": "always",
     "op": "report_terminal_failure",
     "service": "orders"
    }
   ],
   "when": "upgrade_terminal_failure"
  },
  {
   "hook": "before_confirmation",
   "steps": [
    {
     "only_if": "always",
     "op": "read_current_operation"
    },
    {
     "only_if": "always",
     "op": "require_receipt",
     "service": "orders",
     "status": "SUCCEEDED"
    }
   ],
   "when": "upgrade_receipt_missing"
  },
  {
   "hook": "before_final_report",
   "steps": [
    {
     "only_if": "always",
     "op": "read_current_operation"
    },
    {
     "only_if": "always",
     "op": "require_receipt",
     "service": "orders",
     "status": "SUCCEEDED"
    }
   ],
   "when": "upgrade_receipt_missing"
  }
 ],
