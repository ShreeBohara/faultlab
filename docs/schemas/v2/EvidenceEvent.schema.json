{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "attempt_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Ref"
    },
    "causal_parents": {
      "items": {
        "type": "integer"
      },
      "maxItems": 64,
      "title": "Causal Parents",
      "type": "array"
    },
    "certainty": {
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "clock": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clock"
    },
    "clock_sequence": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clock Sequence"
    },
    "kind": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Kind",
      "type": "string"
    },
    "logical_time": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Time"
    },
    "operation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "payload": {
      "$ref": "#/$defs/JsonValue"
    },
    "payload_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "plane": {
      "enum": [
        "agent_visible",
        "evaluator",
        "orchestrator"
      ],
      "title": "Plane",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^/",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "wall_time": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Time"
    }
  },
  "required": [
    "seq",
    "plane",
    "kind",
    "source",
    "certainty",
    "payload",
    "payload_digest"
  ],
  "title": "EvidenceEvent",
  "type": "object"
}
