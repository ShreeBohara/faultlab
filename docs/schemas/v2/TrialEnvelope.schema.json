{
  "$defs": {
    "AgentManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "settings_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Digest"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "adapter_id",
        "model"
      ],
      "title": "AgentManifest",
      "type": "object"
    },
    "Caps": {
      "additionalProperties": false,
      "properties": {
        "dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollars"
        },
        "http_attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Attempts"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Calls"
        },
        "ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticks"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Seconds"
        }
      },
      "title": "Caps",
      "type": "object"
    },
    "ClaimScore": {
      "additionalProperties": false,
      "description": "Beliefs versus effects (architecture section 5). ``UNSCORED`` until the oracle exists.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Claims",
          "type": "object"
        },
        "mismatches": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Mismatches",
          "type": "array"
        },
        "status": {
          "default": "UNSCORED",
          "enum": [
            "UNSCORED",
            "SCORED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "ClaimScore",
      "type": "object"
    },
    "CostSummary": {
      "additionalProperties": false,
      "properties": {
        "dollars_measured": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollars Measured"
        },
        "dollars_reserved": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollars Reserved"
        },
        "http_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Http Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "ticks": {
          "default": 0,
          "minimum": 0,
          "title": "Ticks",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "CostSummary",
      "type": "object"
    },
    "EnvSpec": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "simulator",
            "staging"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EnvSpec",
      "type": "object"
    },
    "EvidenceEvent": {
      "additionalProperties": false,
      "properties": {
        "attempt_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Ref"
        },
        "causal_parents": {
          "items": {
            "type": "integer"
          },
          "maxItems": 64,
          "title": "Causal Parents",
          "type": "array"
        },
        "certainty": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "clock": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock"
        },
        "clock_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Sequence"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "logical_time": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Time"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "payload_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "plane": {
          "enum": [
            "agent_visible",
            "evaluator",
            "orchestrator"
          ],
          "title": "Plane",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "wall_time": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Time"
        }
      },
      "required": [
        "seq",
        "plane",
        "kind",
        "source",
        "certainty",
        "payload",
        "payload_digest"
      ],
      "title": "EvidenceEvent",
      "type": "object"
    },
    "ExecutionIdentity": {
