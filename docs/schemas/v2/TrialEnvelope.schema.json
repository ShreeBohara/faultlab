          },
          "maxItems": 64,
          "title": "Required Fault Ids",
          "type": "array"
        }
      },
      "title": "ExposureSummary",
      "type": "object"
    },
    "FaultExposure": {
      "additionalProperties": false,
      "properties": {
        "attempt_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Ref"
        },
        "configured": {
          "default": true,
          "title": "Configured",
          "type": "boolean"
