        "kind",
        "projection",
        "mapping_digest"
      ],
      "title": "SourceDescriptor",
      "type": "object"
    },
    "TrialAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Attempt Id",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "lifecycle": {
          "enum": [
            "CREATED",
            "READY",
            "RUNNING",
            "SETTLING",
            "TERMINAL"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "parent_attempt": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Attempt"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        }
      },
      "required": [
        "attempt_id",
        "plan_hash",
        "lifecycle"
      ],
      "title": "TrialAttempt",
      "type": "object"
    },
    "TrialPlan": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentManifest"
        },
        "caps": {
          "$ref": "#/$defs/Caps"
        },
        "environment": {
          "$ref": "#/$defs/EnvSpec"
        },
        "fixture_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Digest"
        },
        "fixture_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Id"
        },
        "pack_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Digest"
        },
        "pack_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "properties_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties Digest"
        },
        "protocol_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "repetition": {
          "$ref": "#/$defs/RepetitionPolicy"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schedule": {
          "$ref": "#/$defs/FaultSchedule"
        }
      },
      "required": [
        "pack_id",
        "scenario_id",
        "agent",
        "environment",
        "protocol_version"
      ],
      "title": "TrialPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "$ref": "#/$defs/TrialAttempt"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EvidenceEvent"
      },
      "maxItems": 4096,
      "title": "Events",
      "type": "array"
    },
    "facts_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Facts Digest",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ResultVector"
    },
    "plan": {
      "$ref": "#/$defs/TrialPlan"
    },
    "report": {
      "$ref": "#/$defs/Report"
    },
    "schema_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "faultlab-trial-envelope/v2",
      "default": "faultlab-trial-envelope/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceDescriptor"
    },
    "source_facts": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Source Facts",
      "type": "object"
    }
  },
  "required": [
    "schema_digest",
    "plan",
    "attempt",
    "report",
    "outcome",
    "source",
    "source_facts",
    "facts_digest",
    "digest"
  ],
  "title": "TrialEnvelope",
  "type": "object"
}
