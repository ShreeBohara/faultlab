            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Digest"
        },
        "adapter_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "configuration_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Digest"
        },
        "kernel_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kernel Digest"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_settings_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Settings Digest"
        },
        "pack_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Digest"
        },
        "pack_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "properties_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties Digest"
        },
        "protocol_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "pack_id",
        "adapter_id",
        "model",
        "protocol_version"
      ],
      "title": "ExecutionIdentity",
      "type": "object"
    },
    "ExposureSummary": {
      "additionalProperties": false,
      "properties": {
        "faults": {
          "items": {
            "$ref": "#/$defs/FaultExposure"
          },
          "maxItems": 64,
