        "fault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Fault Id",
          "type": "string"
        },
        "not_triggered_reason": {
          "anyOf": [
            {
              "enum": [
                "target_not_reached",
                "target_not_committed",
                "pre_effect_failure",
                "avoided_by_alternative_path",
                "unclassified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Triggered Reason"
