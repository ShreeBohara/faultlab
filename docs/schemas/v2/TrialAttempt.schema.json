{
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "lifecycle": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "SETTLING",
        "TERMINAL"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "parent_attempt": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Attempt"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "terminal_reason": {
      "anyOf": [
        {
          "maxLength": 600,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Reason"
    }
  },
  "required": [
    "attempt_id",
    "plan_hash",
    "lifecycle"
  ],
  "title": "TrialAttempt",
  "type": "object"
}
