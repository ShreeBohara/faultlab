{
  "$defs": {
    "AgentManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "settings_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Digest"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "adapter_id",
        "model"
      ],
      "title": "AgentManifest",
      "type": "object"
    },
    "Caps": {
      "additionalProperties": false,
      "properties": {
        "dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollars"
        },
        "http_attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Attempts"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Calls"
        },
        "ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticks"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Seconds"
        }
      },
      "title": "Caps",
      "type": "object"
    },
    "EnvSpec": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "simulator",
            "staging"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EnvSpec",
      "type": "object"
    },
    "FaultPlacement": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "fault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Fault Id",
          "type": "string"
        },
        "occurrence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "service": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "tool": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "fault_id",
        "family"
      ],
      "title": "FaultPlacement",
      "type": "object"
    },
    "FaultSchedule": {
      "additionalProperties": false,
      "properties": {
        "placements": {
          "items": {
            "$ref": "#/$defs/FaultPlacement"
          },
          "maxItems": 64,
          "title": "Placements",
          "type": "array"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "FaultSchedule",
      "type": "object"
    },
    "JsonValue": {},
    "RepetitionPolicy": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "default": 1,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "pairing": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairing"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "RepetitionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentManifest"
    },
    "caps": {
      "$ref": "#/$defs/Caps"
    },
    "environment": {
      "$ref": "#/$defs/EnvSpec"
    },
    "fixture_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Digest"
    },
    "fixture_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Id"
    },
    "pack_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pack Digest"
    },
    "pack_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "properties_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Properties Digest"
    },
    "protocol_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "repetition": {
      "$ref": "#/$defs/RepetitionPolicy"
    },
    "scenario_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schedule": {
      "$ref": "#/$defs/FaultSchedule"
    }
  },
  "required": [
    "pack_id",
    "scenario_id",
    "agent",
    "environment",
    "protocol_version"
  ],
  "title": "TrialPlan",
  "type": "object"
}
